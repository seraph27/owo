---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import Layout from '@/layouts/Layout.astro'
import { DataTable } from "./data-table.tsx"
import { type Problem, columns } from "./columns.tsx"

const sheetId = '1YRglBS3ZPArZ-miCc4VXYE1DaSunEHjf4vZVBJ_u2b8'; 
const apiKey = 'AIzaSyCMv2W0Ase-dFS1y2RjJSXAxuhOsFIcJHI';
const values = 'A2:C390'; //change the range to match your sheet

const fetchData = async () => {
  const response = await fetch(
    `https://sheets.googleapis.com/v4/spreadsheets/${sheetId}/values/${values}?key=${apiKey}`
  );
  const data = await response.json();
//   console.log(data);
  return data.values; // This returns the rows as arrays
};

const data = await fetchData();
const codeforcesData = data.map((entry: string[]) => {
    return {
        date: entry[0],
        problems: entry[1],
        resources: entry[2],
    };
});
---

<Layout title="Codeforces" description="A list of recent Codeforces problems.">
    <Container class="flex flex-col gap-y-6">
        <Breadcrumbs items={[{ label: 'Tables', icon: 'lucide:receipt' }]} />
        <DataTable client:load columns={columns} data={codeforcesData} />
    </Container>
</Layout>
