---
export const prerender = false
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import Layout from '@/layouts/Layout.astro'
import { DataTable } from './data-table.tsx'

const sheetId = '1YRglBS3ZPArZ-miCc4VXYE1DaSunEHjf4vZVBJ_u2b8'
const apiKey = 'AIzaSyCMv2W0Ase-dFS1y2RjJSXAxuhOsFIcJHI'
const values = 'A2:F427' //change the range to match your sheet

const fetchData = async () => {
  const response = await fetch(
    `https://sheets.googleapis.com/v4/spreadsheets/${sheetId}/values/${values}?key=${apiKey}`,
  )
  const data = await response.json()
  //   console.log(data);
  return data.values // This returns the rows as arrays
}

const data = await fetchData()
const codeforcesData = data.map((entry: any) => {
  return {
    date: entry[0],
    problems: entry[1],
    tags: entry[2],
    isContest: entry[4],
    resources: entry[5],
  }
})

const filteredData = codeforcesData.filter(
  (entry: any) => entry.isContest === 'FALSE',
)
---

<Layout title="Codeforces" description="A list of recent Codeforces problems.">
  <Container class="flex flex-col gap-y-6">
    <Breadcrumbs items={[{ label: 'Tables', icon: 'lucide:receipt' }]} />
    <!-- <div>{filteredData}</div> -->
    <DataTable client:load data={filteredData} />
  </Container>
</Layout>
