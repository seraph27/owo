---
import { CodeforcesRatingChart } from '@/components/seraph/codeforces-rating-chart'
import { CodeforcesSubmissionsChart } from '@/components/seraph/codeforces-submissions'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)
---

<Layout title="Home" description={SITE.DESCRIPTION}>
  <div class="flex justify-center">
    <div class="grid w-full max-w-6xl grid-cols-1 gap-4 lg:grid-cols-4 mx-12">
      <div class="col-span-1 flex max-w-fit">
        <CodeforcesSubmissionsChart client:load />
      </div>
      <div class="col-span-3">
        <CodeforcesRatingChart client:load />
      </div>
    </div>
  </div>
</Layout>
